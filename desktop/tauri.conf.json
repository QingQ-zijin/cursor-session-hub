{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Session Hub",
  "version": "1.5.5",
  "identifier": "io.qingq.cursor-session-hub",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cursor Session Hub",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/hub-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "shortDescription": "Read, select and share Cursor sessions with your team",
    "copyright": "2026 QingQ-zijin. Includes MIT licensed work by Tim Hua."
  }
}
