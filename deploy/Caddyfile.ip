{
    default_sni {$CSH_DOMAIN}
}

https://{$CSH_DOMAIN} {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
        }
    }
    encode zstd gzip
    request_body {
        max_size 513MB
    }
    reverse_proxy api:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
