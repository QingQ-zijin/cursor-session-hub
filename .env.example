# Generate a long random value. URL-safe letters/digits recommended.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CSH_PORT=8088
CSH_PUBLIC_URL=http://localhost:8088
CSH_COOKIE_SECURE=0
# Production only:
CSH_DOMAIN=sessions.example.com
# Reserve at least 5GiB or10% by default. Test overrides should remain local.
CSH_MIN_FREE_BYTES=5368709120
CSH_MIN_FREE_RATIO=0.10
